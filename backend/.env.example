# Contact form — environment configuration
# Copy this file to ".env" in the same folder as server.js and
# fill in your real SMTP details. Never commit the real .env.

# SMTP server hostname, e.g. smtp.gmail.com or smtp.office365.com
SMTP_HOST=smtp.example.com

# SMTP port: 587 for STARTTLS (common), 465 for implicit TLS
SMTP_PORT=587

# Use "true" only with port 465 (implicit TLS); otherwise "false"
SMTP_SECURE=false

# SMTP login username — usually your full email address
SMTP_USER=your-smtp-username@example.com

# SMTP login password or app password (keep this secret)
SMTP_PASS=your-smtp-password-or-app-password

# Address the enquiry email is sent FROM (must be allowed by your SMTP provider)
MAIL_FROM="TTI Website <no-reply@example.com>"

# Address enquiries are delivered TO (your inbox)
MAIL_TO=hello@example.com

# Optional: text prepended to every enquiry email subject line
MAIL_SUBJECT_PREFIX=[TTI]

# Optional: port this backend listens on (default 3000)
# PORT=3000

# --- Security (all optional) ---
# Set to "1" when running behind Cloudflare or a reverse proxy, so rate limiting sees real visitor IPs
# TRUST_PROXY=1
# Max enquiries per IP per 10 minutes (default 5)
# RATE_LIMIT_MAX=5
# Only when the site and this API are on different origins, e.g. https://yourdomain.com
# ALLOWED_ORIGIN=
# Cloudflare Turnstile secret key (pair with turnstileSiteKey in site/js/config.js)
# TURNSTILE_SECRET_KEY=
